# Block access to sensitive files
<FilesMatch "\.(sql|yml|yaml|md|txt|sh|ini|env|json|lock|bak|log)$">
    Require all denied
</FilesMatch>

# Block hidden files and .git (starting with .)
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Block .git directory traversal
RedirectMatch 404 /\.git
